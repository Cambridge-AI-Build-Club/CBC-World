# Embed URL of the sign-up form shown in the "Join the map" dialog.
# Google Forms: Send -> <> (embed) -> copy the src URL, e.g.
#   https://docs.google.com/forms/d/e/<FORM_ID>/viewform?embedded=true
# Microsoft Forms: Collect responses -> Embed -> copy the src URL, e.g.
#   https://forms.office.com/Pages/ResponsePage.aspx?id=<FORM_ID>&embed=true
VITE_FORM_EMBED_URL=

# Optional: a plain link to the same form, opened in a new tab.
VITE_FORM_LINK=
